{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "S3Access",
			"Effect": "Allow",
			"Action": [
				"s3:GetObject",
				"s3:PutObject",
				"s3:ListBucket",
				"s3:GetBucketLocation"
			],
			"Resource": [
				"arn:aws:s3:::yt-data-pipeline-bronze-manshi",
				"arn:aws:s3:::yt-data-pipeline-bronze-manshi/*",
				"arn:aws:s3:::yt-data-pipeline-silver-manshi",
				"arn:aws:s3:::yt-data-pipeline-silver-manshi/*",
				"arn:aws:s3:::yt-data-pipeline-gold-manshi",
				"arn:aws:s3:::yt-data-pipeline-gold-manshi/*",
				"arn:aws:s3:::yt-data-pipeline-scripts-manshi",
				"arn:aws:s3:::yt-data-pipeline-scripts-manshi/*",
				"arn:aws:s3:::yt-data-pipeline-athena-results-manshi",
				"arn:aws:s3:::yt-data-pipeline-athena-results-manshi/*"
			]
		},
		{
			"Sid": "GlueAccess",
			"Effect": "Allow",
			"Action": [
				"glue:GetTable",
				"glue:GetDatabase",
				"glue:CreateTable",
				"glue:UpdateTable",
				"glue:GetPartitions",
				"glue:CreatePartition",
				"glue:BatchCreatePartition"
			],
			"Resource": "*"
		},
		{
			"Sid": "SNSAccess",
			"Effect": "Allow",
			"Action": [
				"sns:Publish"
			],
			"Resource": "arn:aws:sns:ap-south-1:766696031020:yt-data-pipeline-sns-alert"
		},
		{
			"Sid": "AthenaAccess",
			"Effect": "Allow",
			"Action": [
				"athena:StartQueryExecution",
				"athena:GetQueryExecution",
				"athena:GetQueryResults",
				"athena:GetWorkGroup"
			],
			"Resource": "*"
		}
	]
}
