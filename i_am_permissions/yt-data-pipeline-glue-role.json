{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "S3Access",
			"Effect": "Allow",
			"Action": [
				"s3:GetObject",
				"s3:PutObject",
				"s3:ListBucket"
			],
			"Resource": [
				"arn:aws:s3:::yt-data-pipeline-bronze-manshi/*",
				"arn:aws:s3:::yt-data-pipeline-bronze-manshi",
				"arn:aws:s3:::yt-data-pipeline-silver-manshi/*",
				"arn:aws:s3:::yt-data-pipeline-silver-manshi",
				"arn:aws:s3:::yt-data-pipeline-gold-manshi/*",
				"arn:aws:s3:::yt-data-pipeline-gold-manshi",
				"arn:aws:s3:::yt-data-pipeline-scripts-manshi/*",
				"arn:aws:s3:::yt-data-pipeline-scripts-manshi"
			]
		}
	]
}
